# Copia este archivo a .env y completa los valores (el .env NO se sube al repositorio)
# Cadena de conexión de MongoDB Atlas (o mongodb://127.0.0.1:27017/trionix-tickets en local)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/trionix-tickets?retryWrites=true&w=majority
# Puerto (las plataformas como Render lo definen solas)
PORT=3000
